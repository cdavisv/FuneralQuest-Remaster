{
  "name": "@fq/mobile",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Funeral Quest mobile app (Capacitor 8): wraps the @fq/client bundle for Android and iOS.",
  "type": "module",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "icons": "node scripts/make-icons.mjs",
    "sync": "node scripts/prepare-web.mjs && cap sync",
    "android": "node scripts/prepare-web.mjs && cap sync android && cap open android",
    "android:debug": "node scripts/build-android.mjs debug",
    "android:release": "node scripts/build-android.mjs release",
    "ios": "node scripts/prepare-web.mjs && cap sync ios && cap open ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/browser": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "esbuild": "*"
  }
}
