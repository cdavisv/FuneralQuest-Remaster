{
  "name": "@fq/client",
  "version": "0.0.0",
  "private": true,
  "description": "Funeral Quest web client: draws any View from @fq/protocol and reports button presses.",
  "type": "module",
  "scripts": {
    "art": "node tools/derive-ui-art.mjs",
    "dev": "node tools/derive-ui-art.mjs && vite",
    "build": "node tools/derive-ui-art.mjs && tsc --noEmit && vite build",
    "bundle": "node tools/derive-ui-art.mjs && vite build",
    "perf": "playwright test -c perf/playwright.config.ts",
    "bundle:check": "node tools/check-bundle.mjs",
    "bundle:size": "node tools/check-bundle.mjs --print",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tools/derive-ui-art.mjs && vitest run",
    "play": "node tools/run-server.mjs",
    "e2e": "playwright test",
    "icons": "node tools/make-icons.mjs",
    "capture": "tsx tools/capture-expanded.mts",
    "e2e:chromium": "FQ_E2E_BROWSERS=chromium playwright test",
    "e2e:firefox": "FQ_E2E_BROWSERS=firefox playwright test",
    "e2e:webkit": "FQ_E2E_BROWSERS=webkit playwright test",
    "e2e:online": "playwright test --project 'online-*'",
    "e2e:solo": "playwright test --project 'solo-*'",
    "e2e:expanded": "playwright test --project 'expanded-*' --project 'online-*' -g Expanded",
    "e2e:museum": "playwright test --project 'museum-*'"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fq/audio": "workspace:*",
    "@fq/core": "workspace:*",
    "@fq/protocol": "workspace:*",
    "@fq/server": "workspace:*",
    "@fq/solo": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fq/content": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
