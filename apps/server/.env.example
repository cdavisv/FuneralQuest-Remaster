# Funeral Quest server configuration. Copy to .env and edit; never commit .env.
# Every value has a default; only FQ_ADMIN_TOKEN is something you will want to set.

# --- Network ---------------------------------------------------------------------------
# Address and port to listen on. In Docker the image already sets 0.0.0.0:8080.
FQ_HOST=127.0.0.1
FQ_PORT=8080
# Behind a reverse proxy, say how many proxies to trust so rate limits and bans see the real
# client address: "1", "true", or a comma list of proxy addresses. Leave "false" if the
# server is reached directly (a wrong value lets clients fake their address).
FQ_TRUST_PROXY=false
# Browser origins allowed to call the API from another site, comma separated
# (for example https://play.example.com). Empty allows only same-origin use.
FQ_ALLOWED_ORIGINS=

# --- Storage ---------------------------------------------------------------------------
# SQLite database file (accounts, sessions, towns, snapshots, audit log).
FQ_DB_PATH=./data/fq.sqlite

# --- Admin -----------------------------------------------------------------------------
# Bearer token for /admin, at least 24 characters. Generate one with: openssl rand -hex 32
# Leave empty to switch the admin API off.
FQ_ADMIN_TOKEN=

# --- Towns -----------------------------------------------------------------------------
# JSON file listing towns to create when they are missing (see towns.example.json).
FQ_TOWNS_FILE=
# Directory holding extra content packs, one subdirectory per pack (each with a pack.yaml; the
# format of @fq/content's loadPackFromDirectory). Checked at start-up: a broken pack stops the
# server with the file and entry named. Towns choose a pack by its id (admin API). Empty = only
# the built-in "classic", "vintage" and "expanded". Packs are read once; restart to pick up edits.
FQ_PACKS_DIR=
# Create the default towns if the database has no towns at all and FQ_TOWNS_FILE names none.
FQ_CREATE_DEFAULT_TOWN=true
# Which default towns: "both" (the Expanded flagship "expanded", a 30-day season with the tournament
# reset, then the Classic town "main"), "expanded" or "classic". Ignored once the database has towns.
FQ_DEFAULT_TOWNS=both

# --- Web client ------------------------------------------------------------------------
# Directory holding the built web client (must contain index.html). Empty serves the API only.
# `pnpm --filter @fq/client build` writes it to apps/client/dist-build; the Docker image sets it.
FQ_CLIENT_DIR=

# --- Museum mode -----------------------------------------------------------------------
# Serve the original 2001 Flash client (under Ruffle) at /museum/, playing the same town as the
# web client: log on with the same account name and password, in either client. Off by default.
# The original sounds are inside those files and are licensed only for Funeral Quest (see README).
FQ_LEGACY_CLIENT=false
# The town the original client joins; empty means the first Classic town. It only plays Classic:
# an Expanded town gets an explanation page instead.
FQ_LEGACY_TOWN=
# A bundled server (pnpm build, Docker) needs this: a directory holding public/ (a copy of
# legacy/dist/public), ruffle/ (the @ruffle-rs/ruffle package) and manifest.json (assets/manifest.json).
# The Docker image sets it to /museum (filled when built with INCLUDE_MUSEUM=1). Empty uses the repository.
FQ_MUSEUM_DIR=

# --- Accounts --------------------------------------------------------------------------
FQ_SIGNUP_ENABLED=true
FQ_GUEST_ENABLED=true
FQ_SESSION_TTL_DAYS=30
# Argon2id cost. The defaults are OWASP's minimum (19 MiB, 2 passes); raise if you have room.
FQ_ARGON2_MEMORY_KIB=19456
FQ_ARGON2_PASSES=2

# --- Play ------------------------------------------------------------------------------
# Minutes without an action before a player is logged off (the engine's leaveGame).
FQ_IDLE_TIMEOUT_MINUTES=15
FQ_IDLE_SWEEP_SECONDS=30
# Most missed days run when the server was down (safety cap).
FQ_MAX_CATCH_UP_DAYS=365
# Rollback snapshots: how often (when anything changed) and how many to keep per town.
FQ_SNAPSHOT_INTERVAL_MINUTES=60
FQ_SNAPSHOT_KEEP=48

# --- Limits ----------------------------------------------------------------------------
# Largest request body in bytes.
FQ_BODY_LIMIT_BYTES=16384
# Requests allowed per window: per address in general, per address on sign-up/log-in/guest,
# per account on game actions, per address on /admin.
FQ_RATE_WINDOW_SECONDS=60
FQ_RATE_GLOBAL_MAX=600
FQ_RATE_AUTH_MAX=10
FQ_RATE_ACTION_MAX=120
FQ_RATE_ADMIN_MAX=120

# --- Player safety ---------------------------------------------------------------------
# A file of strictly blocked words for announcements, names and parlor names. One entry per line:
# a plain word, or "sha256:<hex>" (the hash of the normalised word; `pnpm --filter @fq/server
# blocklist:hash words.txt` makes them), optionally with a leading "~" to match inside other words.
# Never commit the list. Empty = no strict list (the engine's own swear filter still applies).
FQ_BLOCKLIST_FILE=
# Shown on the public page /account/delete and in the admin page. Empty shows a marked blank.
FQ_CONTACT_EMAIL=
# Reports one account may file per hour and per day.
FQ_REPORT_MAX_PER_HOUR=10
FQ_REPORT_MAX_PER_DAY=30
# An account reported by this many distinct registered accounts within the window is muted for
# FQ_AUTOMUTE_HOURS pending a moderator's review. 0 turns the safeguard off.
FQ_AUTOMUTE_REPORTS=3
FQ_AUTOMUTE_WINDOW_MINUTES=60
FQ_AUTOMUTE_HOURS=24
# The in-memory cafe window kept so a chat report has context: lines per town, minutes a line stays.
# It is never written to disk unless a report captures it.
FQ_CHAT_BUFFER_LINES=100
FQ_CHAT_BUFFER_MINUTES=30
# Reports that were dismissed or acted on are deleted after this many days (0 keeps them).
FQ_REPORT_RETENTION_DAYS=180

# --- Logging ---------------------------------------------------------------------------
# fatal, error, warn, info, debug, trace or silent. Logs are JSON lines on stdout.
FQ_LOG_LEVEL=info

# --- Docker compose only ---------------------------------------------------------------
# Host port to publish.
FQ_PUBLISH_PORT=8080
# Build museum mode's files into the image (1 or 0). Read by `docker compose build`, not by the
# server: put it in your shell or in a .env next to the compose file.
FQ_INCLUDE_MUSEUM=0
