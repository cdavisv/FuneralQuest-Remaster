{
  "name": "@fq/server",
  "version": "0.0.0",
  "private": true,
  "description": "Funeral Quest game server: Fastify, WebSocket, SQLite, day scheduler, admin API.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/server.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "blocklist:hash": "tsx src/moderation/blocklistCli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@fq/content": "workspace:*",
    "@fq/core": "workspace:*",
    "@fq/legacy-compat": "workspace:*",
    "@fq/protocol": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
