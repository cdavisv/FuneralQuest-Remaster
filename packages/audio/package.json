{
  "name": "@fq/audio",
  "version": "0.0.0",
  "private": true,
  "description": "Funeral Quest Remastered audio: a small synthesiser and sequencer, the score, the effects, the cue map and the build that renders them.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog.ts"
  },
  "scripts": {
    "render": "tsx scripts/render.ts",
    "analyse": "tsx scripts/analyse.ts",
    "studio": "tsx scripts/studio.ts",
    "listen-page": "tsx scripts/listen.ts",
    "remaster-brief": "tsx scripts/remasterBrief.ts",
    "voice-inventory": "tsx scripts/voiceInventory.ts",
    "voice": "tsx scripts/voiceBuild.ts",
    "originals": "tsx scripts/originals.ts && tsx scripts/listen.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fq/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15"
  }
}
