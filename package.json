{
  "name": "funeral-quest-remastered",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "Remaster of Funeral Quest (Robinson Technologies, 2001): Classic and Expanded rulesets on one TypeScript engine.",
  "license": "SEE LICENSE IN license.txt",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check --max-diagnostics=200 .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "play": "pnpm --filter @fq/client play",
    "play:museum": "pnpm --filter @fq/client play --museum",
    "dev:server": "pnpm --filter @fq/server dev",
    "dev:client": "pnpm --filter @fq/client dev",
    "e2e": "pnpm --filter @fq/client e2e",
    "sim": "pnpm --filter @fq/sim run sim --",
    "desktop:dev": "pnpm --filter @fq/desktop dev",
    "desktop:build": "pnpm --filter @fq/desktop build",
    "mobile:sync": "pnpm --filter @fq/mobile sync",
    "mobile:android": "pnpm --filter @fq/mobile android",
    "listen": "node packages/audio/scripts/listen-server.mjs",
    "listen:originals": "pnpm --filter @fq/audio run originals"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
