      "duration": 3.91
    },
    {
      "key": "elijah-d791a9fc2ed3e42a",
      "character": "elijah",
      "speaker": "Elijah",
      "text": "I'm sorry, I really don't have time to waste.",
      "part": "head",
      "rulesets": [
        "classic",
        "expanded"
      ],
      "file": {
        "ogg": "elijah/elijah-d791a9fc2ed3e42a.ogg",
