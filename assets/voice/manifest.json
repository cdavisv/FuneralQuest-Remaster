      "rulesets": [
        "expanded"
      ],
      "file": {
        "ogg": "elijah/elijah-bfceb479dcc22a4f.ogg",
        "m4a": "elijah/elijah-bfceb479dcc22a4f.m4a",
        "bytes": 58544
      },
      "duration": 6.15
    },
    {
      "key": "elijah-1bb109889f7afe4a",
      "character": "elijah",
      "speaker": "Elijah",
      "text": "I'll have the boy drop them off. The boy is 64.",
      "part": "tail",
      "rulesets": [
        "expanded"
      ],
      "file": {
        "ogg": "elijah/elijah-1bb109889f7afe4a.ogg",
        "m4a": "elijah/elijah-1bb109889f7afe4a.m4a",
        "bytes": 37842
